{
  "manifest_version": 3,
  "name": "Shamelessly Vibe-Coded Form Filler",
  "version": "1.1.0",
  "description": "Automatically fills forms with random data - dropdowns, text inputs, textareas, checkboxes, and radio buttons",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shamelessly Vibe-Coded Form Filler",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "shamelessly-vibe-coded-form-filler@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
