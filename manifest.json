{
  "manifest_version": 3,
  "name": "Lorem Ipsform",
  "version": "1.1.0",
  "description": "Fills web forms with random test data: text, emails, phone numbers, dropdowns, checkboxes and radio buttons",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lorem Ipsform: fill forms with random test data",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lorem-ipsform@brianjcohen.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
